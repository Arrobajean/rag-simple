# ── Obligatorias ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Project Settings > API > service_role (secreta; solo servidor)
SUPABASE_KEY=tu_service_role_key

# Acceso a la aplicación (en producción sin esto nadie puede entrar)
APP_PASSWORD=contraseña_de_gestor
APP_ADMIN_PASSWORD=contraseña_de_administrador
# Solo para pruebas con datos ficticios: desactiva el login (cualquiera con la URL entra como admin)
# APP_OPEN=true
# Firma de las cookies de sesión (opcional: si falta se usa SUPABASE_KEY)
AUTH_SECRET=cadena_larga_aleatoria

# ── Modelos de Gemini ────────────────────────────────────────────────────────
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
# Opcionales: modelo para OCR/lector (por defecto el del chat) y reserva si se agota la cuota diaria
# GEMINI_DOCS_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite-preview

# ── Opcionales ───────────────────────────────────────────────────────────────
# Clave pública (anon): permite subir PDFs de más de 4 MB directamente a Storage
# SUPABASE_ANON_KEY=
# Cadena de conexión (Connect > Session pooler): habilita `pnpm db:migrate` y un seed más rápido
# SUPABASE_DB_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
